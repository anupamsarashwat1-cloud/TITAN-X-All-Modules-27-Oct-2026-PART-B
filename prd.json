  "module_pinouts_and_formal_constraints": {
    "rv_core_top": {
      "clock_domain": "core_clk (100-200 MHz)",
      "reset_domain": "rst_n (asynchronous assert, synchronous release)",
      "primary_pinout": [
        {
          "pin": "clk",
          "dir": "input",
          "width": 1,
          "desc": "Core clock"
        },
        {
          "pin": "rst_n",
          "dir": "input",
          "width": 1,
          "desc": "Active-low reset"
        },
        {
          "pin": "irq_m_ext",
          "dir": "input",
          "width": 1,
          "desc": "PLIC machine external interrupt"
        },
        {
          "pin": "irq_m_timer",
          "dir": "input",
          "width": 1,
          "desc": "CLINT machine timer interrupt"
        },
        {
          "pin": "irq_m_soft",
          "dir": "input",
          "width": 1,
          "desc": "CLINT machine software interrupt"
        },
        {
          "pin": "imem_arvalid",
          "dir": "output",
          "width": 1,
          "desc": "Instruction fetch address valid"
        },
        {
          "pin": "imem_arready",
          "dir": "input",
          "width": 1,
          "desc": "Instruction fetch address ready"
        },
        {
          "pin": "imem_araddr",
          "dir": "output",
          "width": 40,
          "desc": "Instruction fetch physical address"
        },
        {
          "pin": "imem_rvalid",
          "dir": "input",
          "width": 1,
          "desc": "Instruction read data valid"
        },
        {
          "pin": "imem_rready",
          "dir": "output",
          "width": 1,
          "desc": "Instruction read data ready"
        },
        {
          "pin": "imem_rdata",
          "dir": "input",
          "width": 64,
          "desc": "Fetched 64-bit instruction bundle"
        },
        {
          "pin": "dmem_awvalid",
          "dir": "output",
          "width": 1,
          "desc": "Data bus write address valid"
        },
        {
          "pin": "dmem_awaddr",
          "dir": "output",
          "width": 40,
          "desc": "Data bus write address"
        },
        {
          "pin": "dmem_wvalid",
          "dir": "output",
          "width": 1,
          "desc": "Data bus write data valid"
        },
        {
          "pin": "dmem_wdata",
          "dir": "output",
          "width": 64,
          "desc": "Data bus write data"
        },
        {
          "pin": "dmem_wstrb",
          "dir": "output",
          "width": 8,
          "desc": "Data bus byte enable strobes"
        },
        {
          "pin": "dmem_arvalid",
          "dir": "output",
          "width": 1,
          "desc": "Data bus read address valid"
        },
        {
          "pin": "dmem_araddr",
          "dir": "output",
          "width": 40,
          "desc": "Data bus read address"
        },
        {
          "pin": "dmem_rvalid",
          "dir": "input",
          "width": 1,
          "desc": "Data bus read data valid"
        },
        {
          "pin": "dmem_rdata",
          "dir": "input",
          "width": 64,
          "desc": "Data bus read payload"
        }
      ],
      "formal_sva_invariants": [
        {
          "name": "SVA_NO_DUAL_WRITE",
          "prop": "assert property (@(posedge clk) !(dmem_awvalid && dmem_arvalid))",
          "desc": "AXI-Lite master port enforces non-overlapping read/write requests"
        },
        {
          "name": "SVA_HANDSHAKE_STABLE",
          "prop": "assert property (@(posedge clk) imem_arvalid && !imem_arready |=> $stable(imem_araddr))",
          "desc": "Address must hold constant until ready handshake completes"
        },
        {
          "name": "SVA_PC_ALIGNMENT",
          "prop": "assert property (@(posedge clk) imem_arvalid |-> (imem_araddr[1:0] == 2b00))",
          "desc": "Instruction fetch addresses must be 4-byte aligned in RV64G mode"
        }
      ]
    },
    "rv_pmp": {
      "clock_domain": "core_clk",
      "reset_domain": "rst_n",
      "primary_pinout": [
        {
          "pin": "paddr",
          "dir": "input",
          "width": 38,
          "desc": "Access physical address"
        },
        {
          "pin": "check_r",
          "dir": "input",
          "width": 1,
          "desc": "Read permission check strobe"
        },
        {
          "pin": "check_w",
          "dir": "input",
          "width": 1,
          "desc": "Write permission check strobe"
        },
        {
          "pin": "check_x",
          "dir": "input",
          "width": 1,
          "desc": "Execute permission check strobe"
        },
        {
          "pin": "priv_mode",
          "dir": "input",
          "width": 2,
          "desc": "Execution privilege mode (2b11=M, 2b01=S, 2b00=U)"
        },
        {
          "pin": "check_en",
          "dir": "input",
          "width": 1,
          "desc": "Active check enable"
        },
        {
          "pin": "pmp_fault",
          "dir": "output",
          "width": 1,
          "desc": "Access violation fault flag"
        }
      ],
      "formal_sva_invariants": [
        {
          "name": "SVA_M_MODE_BYPASS",
          "prop": "assert property (@(posedge clk) (check_en && priv_mode == 2b11 && !any_locked_match) |-> !pmp_fault)",
          "desc": "Unlocked M-mode accesses always bypass PMP checks"
        },
        {
          "name": "SVA_U_MODE_DEFAULT_DENY",
          "prop": "assert property (@(posedge clk) (check_en && priv_mode == 2b00 && !any_match) |-> pmp_fault)",
          "desc": "User mode accesses with no matching PMP entries default to fault"
        }
      ]
    },
    "axi4_crossbar": {
      "clock_domain": "core_clk / ddr_phy_clk",
      "reset_domain": "rst_n",
      "primary_pinout": [
        {
          "pin": "aclk",
          "dir": "input",
          "width": 1,
          "desc": "Interconnect system clock"
        },
        {
          "pin": "aresetn",
          "dir": "input",
          "width": 1,
          "desc": "Active-low reset"
        },
        {
          "pin": "m_axi_awaddr",
          "dir": "output",
          "width": 40,
          "desc": "Master crossbar output address"
        },
        {
          "pin": "m_axi_wdata",
          "dir": "output",
          "width": 64,
          "desc": "Master crossbar output data payload"
        },
        {
          "pin": "m_axi_wvalid",
          "dir": "output",
          "width": 1,
          "desc": "Master write data strobe"
        }
      ],
      "formal_sva_invariants": [
        {
          "name": "SVA_MUTEX_GRANT",
          "prop": "assert property (@(posedge aclk) $onehot0(master_grants))",
          "desc": "Arbiter grants at most one master access to a slave channel at any cycle"
        },
        {
          "name": "SVA_NO_STARVATION",
          "prop": "assert property (@(posedge aclk) master_req[*8] |-> ##[1:16] master_grant)",
          "desc": "Round-robin arbiter guarantees forward progress within 16 cycles"
        }
      ]
    }
  }

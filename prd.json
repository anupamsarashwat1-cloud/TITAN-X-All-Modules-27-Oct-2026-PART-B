      "status": "READY_FOR_EXECUTION",
      "tools": [
        "Verilator 5.020",
        "Yosys 0.33"
      ],
      "deliverable": "Zero-warning lint sign-off & SCL 180nm logic area/cell estimation",
      "actions": [
        "Run verilator --lint-only -Wall on the entire RTL tree and refactor any synthesizable violations to 0 warnings",
        "Execute Yosys gate-level synthesis exploration on titan_x_top and rv_core_top, logging gate counts and cell areas to progress.txt"
      ]
    },
    "Phase_3_Formal_Verification_and_ABV": {
      "status": "PLANNED",
      "tools": [
        "yosys-smtbmc",
        "z3",
        "SymbiYosys / SVA"
      ],
      "deliverable": "verification_report.md with formal proofs and dynamic simulation delta analysis",
      "actions": [
        "Author SystemVerilog Assertions (SVA) for pipeline hazard invariants, cache coherency, and bus handshakes",
        "Perform SMT-BMC proofs with z3 solver for safety, liveness, and absence of deadlock"
      ]
    },
    "Phase_4_UVM_Architecture_and_Constrained_Random": {
      "status": "PLANNED",
      "framework": "SystemVerilog TLM / UVM Agent Framework",
      "deliverable": "verification/uvm_env/ with Driver, Monitor, Sequencer, Scoreboard, and Random Stimulus Generator",
      "actions": [
        "Develop Transaction-Level Modeling components for AXI4, APB, and CPU Memory Interfaces",
        "Implement constrained-random packet generation to stress-test pipeline corner cases"
      ]
    },
    "Phase_5_Power_Aware_and_Coverage_Analysis": {
      "status": "PLANNED",
      "deliverable": "Coverage database (Statement, Branch, Toggle) and Mock PMU power state logs",
      "actions": [
        "Instrument dynamic simulator for code & toggle coverage extraction",
        "Implement power domain state machine simulating sleep, wake, and clock-gating retention"
      ]
    },
    "Phase_6_Performance_and_Firmware_Boot": {
      "status": "PLANNED",
      "deliverable": "Cycle-accurate benchmark reports, memory latency metrics, and boot UART transcript",
      "actions": [
        "Load firmware.hex into boot ROM (0x10000) and execute baremetal startup across all harts",
        "Measure execution cycles, CPI, cache hit rates, and bus stall penalties"
      ]
    },
    "Phase_7_Telemetry_and_CodeRabbit_Signoff": {
      "status": "PLANNED",
      "deliverable": "Authentic GTKWave waveform screenshots in verification_waves/ and CodeRabbit PR review",
      "actions": [
        "Automate GTKWave on DISPLAY=:0 using Tcl scripts and capture screenshots via scrot",
        "Execute CodeRabbit architectural review for structural integrity, CDC safety, and timing hygiene"
      ]
    }
  },
